# Root-level ignores for the ClawArena monorepo.
# Each subproject (ClawArena/, ClawArena-Team/) keeps its own .gitignore for
# project-specific paths; this file covers the common Python / OS cruft.

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
build/
dist/

# Environments
.venv/
venv/
.env

# Tooling / caches
.pytest_cache/
.idea/
.vscode/
.codex

# Run artifacts
results/
work/
logs/
*.log

# OS
.DS_Store
